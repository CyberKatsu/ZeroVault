# Environment Variables for ZeroVault

# ── JWT Configuration ──────────────────────────────────────────────────────────
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_generate_with_secrets_token_hex_32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database Configuration ─────────────────────────────────────────────────────
# PostgreSQL connection URL for production
DATABASE_URL=postgresql+asyncpg://zerovault:zerovault_dev_password@db:5432/zerovault

# ── Development Overrides ──────────────────────────────────────────────────────
# Override default ports when running docker compose
ZV_DB_PORT=55439
ZV_BACKEND_PORT=38170
ZV_FRONTEND_PORT=37420
ZV_REFLEX_BACKEND_PORT=38171

# ── Debug Mode ────────────────────────────────────────────────────────────────
# Set to "true" for development (enables debug logging, etc.)
DEBUG=false